# Rendered by the nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf at container start.
#
# BACKEND_ORIGIN has to be a variable: the backend's address differs per
# environment (the compose service is "backend", the Kubernetes Service is
# "<release>-backend"), and nginx resolves proxy_pass names at startup, so a
# wrong name here does not degrade the API proxy - it stops nginx from booting
# and takes the whole SPA down with it.

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # The pod terminal is a WebSocket, which only works if the upgrade handshake
  # is forwarded; without these headers nginx answers the upgrade with a plain
  # 200 and the terminal never connects.
  location /api/exec/pod {
    proxy_pass ${BACKEND_ORIGIN}/api/exec/pod;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    # An idle shell must not be dropped mid-session.
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # Live pod log tailing is a long-lived SSE stream, so it needs its own rules:
  # buffering would hold lines back until the pod went quiet, and the default
  # 60s read timeout would drop the connection whenever a pod logs nothing.
  location /api/logs/stream {
    proxy_pass ${BACKEND_ORIGIN}/api/logs/stream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location /api/ {
    proxy_pass ${BACKEND_ORIGIN}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
